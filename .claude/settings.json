{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-I",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/issues.py",
              "start"
            ],
            "timeout": 40
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-I",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/issues.py",
              "stop"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
