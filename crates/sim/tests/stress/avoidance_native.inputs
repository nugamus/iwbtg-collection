# Variant A: native bullets, no per-step script.
#   cargo run -p iwbtg-tools -- replay run crates/sim/tests/stress/avoidance.pkg \
#       crates/sim/tests/stress/avoidance_native.inputs --room native_5000
# `--room native_500` and `--room native_2000` run the smaller rooms; without `--room` a replay
# starts at the package's new-game room, also native_5000.
frame 2: hold right
frame 5: release right
frame 30: end
