{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "ultracode": true,
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "BASH_DEFAULT_TIMEOUT_MS": "900000",
    "BASH_MAX_TIMEOUT_MS": "2700000"
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "caveman@caveman": false,
    "ponytail@ponytail": false
  },
  "deniedMcpServers": [
    { "serverName": "comfy-mcp" },
    { "serverName": "kdenlive" },
    { "serverName": "godot-ai" },
    { "serverName": "rea-linux" }
  ],
  "permissions": {
    "deny": [
      "Read(//**/.env)",
      "Read(//**/.env.*)",
      "Bash(git push --force)",
      "Bash(git push --force *)",
      "Bash(git push -f)",
      "Bash(git push -f *)",
      "Bash(git add -f *)",
      "Bash(git add --force *)",
      "Bash(git clean *)",
      "PowerShell(git push --force)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f)",
      "PowerShell(git push -f *)",
      "PowerShell(git add -f *)",
      "PowerShell(git add --force *)",
      "PowerShell(git clean *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["-I", "${CLAUDE_PROJECT_DIR}/research/.claude/hooks/guard_archive.py"],
            "onFailure": "block",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python",
            "args": ["-I", "${CLAUDE_PROJECT_DIR}/client/.claude/hooks/build_guard.py"],
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python",
            "args": ["-I", "${CLAUDE_PROJECT_DIR}/client/.claude/hooks/conflict_guard.py"],
            "timeout": 20
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["-I", "${CLAUDE_PROJECT_DIR}/client/.claude/hooks/issues.py", "start"],
            "timeout": 40
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["-I", "${CLAUDE_PROJECT_DIR}/client/.claude/hooks/issues.py", "stop"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
