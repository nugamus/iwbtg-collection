{
  "$defs": {
    "Number": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "additionalProperties": false,
          "properties": {
            "bits": {
              "pattern": "^[0-9a-fA-F]{16}$",
              "type": "string"
            }
          },
          "required": [
            "bits"
          ],
          "type": "object"
        }
      ],
      "description": "A number, or { bits = \"<16 hex digits of an IEEE double>\" } for a constant that must match bit for bit."
    },
    "RawCollider": {
      "additionalProperties": false,
      "description": "The `[collider]` table: a canonical collider baked from the art.\n\nIt has either the shared keys (`shape` with `bbox`/`bits`) or one `frames` entry per frame,\nnever both. `alpha_tolerance` is required so the bake cannot silently use a different rule\nfrom the sidecar's.",
      "properties": {
        "alpha_tolerance": {
          "$ref": "#/$defs/Number"
        },
        "bbox": {
          "default": null,
          "items": {
            "format": "int64",
            "type": "integer"
          },
          "maxItems": 4,
          "minItems": 4,
          "type": [
            "array",
            "null"
          ]
        },
        "bits": {
          "default": null,
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "frames": {
          "items": {
            "$ref": "#/$defs/RawColliderFrame"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "shape": {
          "anyOf": [
            {
              "$ref": "#/$defs/RawColliderShape"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "alpha_tolerance"
      ],
      "type": "object"
    },
    "RawColliderFrame": {
      "additionalProperties": false,
      "description": "One frame of a per-frame `[collider]` table.",
      "properties": {
        "bbox": {
          "default": null,
          "items": {
            "format": "int64",
            "type": "integer"
          },
          "maxItems": 4,
          "minItems": 4,
          "type": [
            "array",
            "null"
          ]
        },
        "bits": {
          "default": null,
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "shape": {
          "$ref": "#/$defs/RawColliderShape"
        }
      },
      "required": [
        "shape"
      ],
      "type": "object"
    },
    "RawColliderShape": {
      "description": "The baked shape: `none` (nothing collides), `rect` (the whole box) or `bits` (per pixel).",
      "enum": [
        "none",
        "rect",
        "bits"
      ],
      "type": "string"
    },
    "RawCollision": {
      "enum": [
        "precise",
        "rect",
        "disk",
        "diamond",
        "none"
      ],
      "type": "string"
    },
    "RawRenderBounds": {
      "additionalProperties": false,
      "description": "The `[render_bounds]` table: the rectangle the client draws and culls with.\n\n`shape` says what the bounds describe: the whole frame, every frame's solid collider, or an\nexplicit box. Only `custom` takes a `bbox`.",
      "properties": {
        "bbox": {
          "default": null,
          "items": {
            "format": "int64",
            "type": "integer"
          },
          "maxItems": 4,
          "minItems": 4,
          "type": [
            "array",
            "null"
          ]
        },
        "shape": {
          "$ref": "#/$defs/RawRenderBoundsShape"
        }
      },
      "required": [
        "shape"
      ],
      "type": "object"
    },
    "RawRenderBoundsShape": {
      "description": "What `[render_bounds]` describes.",
      "oneOf": [
        {
          "const": "frame",
          "description": "The whole frame.",
          "type": "string"
        },
        {
          "const": "collider",
          "description": "Every frame's solid collider.",
          "type": "string"
        },
        {
          "const": "custom",
          "description": "An explicit box.",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "alpha_tolerance": {
      "anyOf": [
        {
          "$ref": "#/$defs/Number"
        },
        {
          "type": "null"
        }
      ]
    },
    "bbox": {
      "default": null,
      "items": {
        "format": "int64",
        "type": "integer"
      },
      "maxItems": 4,
      "minItems": 4,
      "type": [
        "array",
        "null"
      ]
    },
    "collider": {
      "anyOf": [
        {
          "$ref": "#/$defs/RawCollider"
        },
        {
          "type": "null"
        }
      ]
    },
    "collision": {
      "anyOf": [
        {
          "$ref": "#/$defs/RawCollision"
        },
        {
          "type": "null"
        }
      ]
    },
    "columns": {
      "default": null,
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "frame_size": {
      "items": {
        "format": "uint32",
        "minimum": 0,
        "type": "integer"
      },
      "maxItems": 2,
      "minItems": 2,
      "type": "array"
    },
    "frames": {
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "mask": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "origin": {
      "items": {
        "format": "int32",
        "type": "integer"
      },
      "maxItems": 2,
      "minItems": 2,
      "type": "array"
    },
    "render_bounds": {
      "anyOf": [
        {
          "$ref": "#/$defs/RawRenderBounds"
        },
        {
          "type": "null"
        }
      ]
    },
    "separate_masks": {
      "default": null,
      "type": [
        "boolean",
        "null"
      ]
    }
  },
  "required": [
    "frames",
    "frame_size",
    "origin"
  ],
  "title": "IWBTG sprites/<id>.toml (format v0)",
  "type": "object"
}
