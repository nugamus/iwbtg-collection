{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iwbtg-collection/format/v0/physics.schema.json",
  "title": "physics.toml (kid physics profile), format v0",
  "description": "A kid physics profile as written in a package. Every key is optional: a missing key takes the value of the preset. Unknown keys are errors. Covers the sections and names of family A1 (WP5a); other families add their names (WP5b, WP5c).",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "real": { "type": "number" },
    "action": {
      "description": "A kid action name for an event list.",
      "enum": [
        "create_defaults", "ensure_world", "create_bow", "first_play_save", "arm_play_timer",
        "gravity", "walk", "air_sprite", "fall_cap", "shoot", "jump", "release", "vines",
        "play_timer", "kill", "platform_gravity_zero", "fade_in", "stop_if_frozen2", "cancel_poll",
        "sync_yflag", "player_reverse", "set_view_angle", "ensure_bow", "killer_check", "slope_b"
      ]
    },
    "actions": { "type": "array", "items": { "$ref": "#/$defs/action" } },
    "class": {
      "description": "A collision class by its package name.",
      "enum": [
        "kid", "kid_flipped", "kid_bullet", "block", "solidblock", "platform", "killer",
        "water1", "water2", "water3", "vine_l", "vine_r", "room_changer", "edge_warp", "save",
        "slip", "slope", "slope_wall", "ladder", "fake_block", "bullet_blocker", "trigger",
        "trap_stopper", "moving_block", "conveyor", "param_zone", "bow", "blood"
      ]
    },
    "classes": { "type": "array", "items": { "$ref": "#/$defs/class" } },
    "actionName": {
      "enum": [
        "left", "right", "up", "down", "jump", "shoot", "restart", "suicide", "skip", "accept",
        "back", "menu", "pause", "mute", "reset", "extra1", "extra2", "extra3", "extra4"
      ]
    }
  },
  "properties": {
    "preset": {
      "description": "The family whose defaults fill every missing key. A1 is rely-the-needle-4-2; the other families currently use the A1 defaults.",
      "enum": ["A1", "A2", "A3", "A4", "A5", "B", "C"]
    },
    "numbers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "jumps": { "type": "array", "items": { "$ref": "#/$defs/real" } },
        "gravity": { "$ref": "#/$defs/real" },
        "run_speed": { "$ref": "#/$defs/real" },
        "max_vspeed": { "$ref": "#/$defs/real" },
        "max_fall_speed": { "$ref": "#/$defs/real" },
        "release_mult": { "$ref": "#/$defs/real" },
        "sprite_threshold": { "$ref": "#/$defs/real" },
        "image_speed_idle": { "$ref": "#/$defs/real" },
        "image_speed_run": { "$ref": "#/$defs/real" },
        "air_wall_probe": { "$ref": "#/$defs/real" }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "walk": { "enum": ["direct_latch", "sampled"] },
        "vine_keys": { "enum": ["edges", "latched_flags"] }
      }
    },
    "events": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "$ref": "#/$defs/actions" },
        "room_start": { "$ref": "#/$defs/actions" },
        "step": { "$ref": "#/$defs/actions" },
        "end_step": { "$ref": "#/$defs/actions" },
        "alarms": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["n", "run"],
            "properties": {
              "n": { "type": "integer", "minimum": 0, "maximum": 11 },
              "run": { "$ref": "#/$defs/actions" }
            }
          }
        },
        "keys": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["action", "on", "run"],
            "properties": {
              "action": { "$ref": "#/$defs/actionName" },
              "on": { "enum": ["held", "press", "release"] },
              "run": { "$ref": "#/$defs/actions" }
            }
          }
        },
        "boundary": {
          "description": "The room edge. outside_room_kill (family B) and end_step_origin are not built yet.",
          "enum": ["none", "intersect_origin", "outside_room_kill", "end_step_origin"]
        },
        "collisions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["with", "run"],
            "properties": {
              "with": { "$ref": "#/$defs/class" },
              "run": { "enum": ["block_standard", "platform_standard", "kill"] }
            }
          }
        }
      }
    },
    "jump": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ground_classes": { "$ref": "#/$defs/classes" },
        "ground_also": {
          "type": "array",
          "items": { "enum": ["platform_flag", "ladder_jump"] }
        },
        "ground_sets_djump": { "type": "boolean" },
        "air": { "enum": ["djump", "cur_jumps", "djump_then_tjump"] },
        "water_air": { "enum": ["none", "water2_without_flag", "water_unlimited", "water3_keeps"] },
        "max_jumps": { "type": "integer", "minimum": 1 },
        "inf_jump": { "type": "boolean" },
        "blocked_by_pause_press": { "type": "boolean" },
        "cancel": { "enum": ["edge", "poll_alarm"] }
      }
    },
    "fall_cap": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rule": {
          "enum": ["clamp_abs", "clamp_against_gravity", "clamp_down_only", "shift_then_clamp"]
        }
      }
    },
    "gravity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reapply": { "enum": ["step", "end_step_slope", "create_only"] },
        "block_landing_zeroes": { "type": "boolean" }
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hold_probe": { "$ref": "#/$defs/real" },
        "rule": { "enum": ["half_vspeed"] },
        "snap": { "$ref": "#/$defs/real" },
        "take": { "enum": ["vspeed", "delta_y", "yspeed_flipped"] },
        "reversed_above": { "$ref": "#/$defs/real" },
        "reversed_snap": { "$ref": "#/$defs/real" }
      }
    },
    "vine": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": { "enum": ["none", "distance_asym", "distance_sym_early"] },
        "left_below": { "$ref": "#/$defs/real" },
        "right_equal": { "$ref": "#/$defs/real" },
        "slide": { "$ref": "#/$defs/real" },
        "kick": {
          "type": "array",
          "items": { "$ref": "#/$defs/real" },
          "minItems": 2,
          "maxItems": 2
        },
        "drop": { "$ref": "#/$defs/real" }
      }
    },
    "water": { "type": "object", "additionalProperties": false },
    "ice": { "type": "object", "additionalProperties": false },
    "slope": { "type": "object", "additionalProperties": false },
    "ladder": { "type": "object", "additionalProperties": false },
    "flip": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": { "enum": ["none", "swap_object", "yflag", "grav_sign"] }
      }
    },
    "death": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "order": {
          "type": "array",
          "items": {
            "enum": ["sound", "blood_emitter", "destroy_kid", "deaths_plus_one", "save_counters", "game_over"]
          }
        },
        "select_room_reset": { "type": "boolean" },
        "stop_music": { "type": "boolean" }
      }
    },
    "bullet": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max": { "type": "integer", "minimum": 0 },
        "speed": { "$ref": "#/$defs/real" },
        "offset": { "type": "array", "items": { "$ref": "#/$defs/real" }, "minItems": 2, "maxItems": 2 }
      }
    },
    "save": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "position": {
          "enum": [
            "xy_base100_bytes", "xy_base256_bytes", "xy_text2_dec", "xy_previous", "fixed_point",
            "floor_nudge"
          ]
        },
        "fixed": {
          "type": "array",
          "items": { "$ref": "#/$defs/real" },
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "misc": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fade_in": { "type": "boolean" },
        "fade_step": { "$ref": "#/$defs/real" }
      }
    },
    "sprites": {
      "description": "Sprite names from the package's sprite table, by role.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "idle": { "type": "string" },
        "running": { "type": "string" },
        "jump": { "type": "string" },
        "fall": { "type": "string" },
        "sliding": { "type": "string" }
      }
    }
  }
}
