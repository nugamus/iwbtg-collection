# Template for /srv/iwbtg/cloudflared.env (docs/server.md, Deployment).
#
#   sudo install -d -m 700 /srv/iwbtg
#   sudo install -m 600 deploy/cloudflared.env.example /srv/iwbtg/cloudflared.env
#   sudoedit /srv/iwbtg/cloudflared.env
#
# Security rule 3: this file holds the tunnel token and nothing else. App secrets
# (OAuth, SMTP) belong in /srv/iwbtg/server.env, never here. Neither file is committed
# or mounted into the server container.
#
# The token comes from the Cloudflare dashboard: Zero Trust > Networks > Tunnels >
# Create a tunnel > Cloudflared, then "Install connector" for Docker. Copy the value
# after `--token` (or from the `tunnel token` command) and paste it below.
TUNNEL_TOKEN=replace-with-the-tunnel-token
